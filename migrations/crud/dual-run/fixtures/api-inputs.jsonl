{"id": "LIST-1", "description": "GET list — both sides return 5 seeded users newest-first", "method": "GET", "path": "/api/users", "expect": {"category": "green_path"}}
{"id": "GET-1", "description": "GET single user by id=1 (Alice)", "method": "GET", "path": "/api/users/1", "expect": {"category": "green_path"}}
{"id": "GET-42", "description": "GET id=42 (does not exist) — 404", "method": "GET", "path": "/api/users/42", "expect": {"category": "error_uplift", "uplift": {"php_status": 404, "fast_status": 404, "message": "Not Found"}}}
{"id": "CREATE-OK", "description": "POST create — valid payload", "method": "POST", "path": "/api/users", "json_body": {"name": "Frank Friedman", "age": 40, "email": "frank@parity.io"}, "expect": {"category": "green_path"}}
{"id": "CREATE-DUP", "description": "POST duplicate email — 409 conflict (UNIQUE(email))", "method": "POST", "path": "/api/users", "json_body": {"name": "Alice 2", "age": 35, "email": "alice@example.com"}, "expect": {"category": "error_uplift", "uplift": {"php_status": 409, "fast_status": 409, "message": "email"}}}
{"id": "CREATE-BAD-EMAIL", "description": "POST invalid email format — 400/422", "method": "POST", "path": "/api/users", "json_body": {"name": "Bad Email", "age": 25, "email": "not-an-email"}, "expect": {"category": "error_uplift", "uplift": {"php_status": 400, "fast_status": 422, "message": "email"}}}
{"id": "CREATE-AGE-LOW", "description": "POST age below range (-5) — 400/422", "method": "POST", "path": "/api/users", "json_body": {"name": "Too Young", "age": -5, "email": "young@parity.io"}, "expect": {"category": "error_uplift", "uplift": {"php_status": 400, "fast_status": 422, "message": "age"}}}
{"id": "CREATE-AGE-HIGH", "description": "POST age above range (200) — 400/422", "method": "POST", "path": "/api/users", "json_body": {"name": "Too Old", "age": 200, "email": "old@parity.io"}, "expect": {"category": "error_uplift", "uplift": {"php_status": 400, "fast_status": 422, "message": "age"}}}
{"id": "CREATE-EMPTY-NAME", "description": "POST empty name — 400/422", "method": "POST", "path": "/api/users", "json_body": {"name": "", "age": 30, "email": "empty@parity.io"}, "expect": {"category": "error_uplift", "uplift": {"php_status": 400, "fast_status": 422, "message": "name"}}}
{"id": "UPDATE-OK", "description": "PUT update name on existing user", "method": "PUT", "path": "/api/users/2", "json_body": {"name": "Bob Baker Updated", "age": 29, "email": "bob@example.com"}, "expect": {"category": "green_path"}}
{"id": "UPDATE-404", "description": "PUT update non-existent user — 404", "method": "PUT", "path": "/api/users/99999", "json_body": {"name": "Ghost", "age": 30, "email": "ghost@parity.io"}, "expect": {"category": "error_uplift", "uplift": {"php_status": 404, "fast_status": 404, "message": "Not Found"}}}
{"id": "DELETE-OK", "description": "DELETE existing user (id=5, Eve)", "method": "DELETE", "path": "/api/users/5", "expect": {"category": "green_path"}}
{"id": "DELETE-404", "description": "DELETE non-existent user — 404", "method": "DELETE", "path": "/api/users/99999", "expect": {"category": "error_uplift", "uplift": {"php_status": 404, "fast_status": 404, "message": "Not Found"}}}
{"id": "LIST-AFTER", "description": "GET list after DELETE-OK — 4 users remain (Eve gone)", "method": "GET", "path": "/api/users", "expect": {"category": "green_path"}}
