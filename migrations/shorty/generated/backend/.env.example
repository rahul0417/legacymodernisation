# All Shorty runtime configuration is read from environment variables
# prefixed with SHORTY_. Copy this file to `.env` and edit; the Settings
# class will pick it up via pydantic-settings.

# ── Required-ish (have safe defaults) ───────────────────────────────────

SHORTY_HOSTNAME=http://localhost:8000
SHORTY_DB_URL=postgresql+asyncpg://shorty:shorty@localhost:5432/shorty

# ── Encoder configuration (Gate 1 LOCKED for production) ────────────────

SHORTY_CHARS=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789
SHORTY_SALT=
SHORTY_PADDING=3

# ── Access control + network ────────────────────────────────────────────

# Comma-separated IPs allowed to CREATE URLs. Empty = open. Lookup is
# always open regardless.
SHORTY_IP_WHITELIST=

# Comma-separated IPs whose X-Forwarded-For header is honoured.
SHORTY_TRUSTED_PROXIES=127.0.0.1

# ── Logging ────────────────────────────────────────────────────────────

SHORTY_LOG_LEVEL=INFO
SHORTY_JSON_LOGS=false

# ── Debug-only ─────────────────────────────────────────────────────────

# When true, SQLAlchemy echoes every SQL statement to stdout. NEVER enable
# in production — leaks URLs into logs.
SHORTY_DB_ECHO=false
