# Parity runner — hits both legacy PHP and new FastAPI, diffs responses,
# writes parity-report.json to /app/reports/.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install --no-cache-dir "httpx==0.27.0"

# Script + fixtures are bind-mounted via docker-compose volumes so edits
# don't require a rebuild. This image is just a Python runtime.

CMD ["python", "/app/parity-runner.py"]
