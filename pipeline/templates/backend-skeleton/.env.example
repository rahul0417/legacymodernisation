# All CRUD Users runtime configuration is read from environment
# variables prefixed with CRUD_. Copy this file to `.env` and edit; the
# Settings class will pick it up via pydantic-settings.

# ── Required-ish (have safe defaults) ───────────────────────────────────

CRUD_DATABASE_URL=postgresql+asyncpg://crud:crud@localhost:5432/crud

# Comma-separated allowlist. Default: the Vite dev server.
CRUD_CORS_ORIGINS=http://localhost:5173

# ── Logging ────────────────────────────────────────────────────────────

CRUD_LOG_LEVEL=INFO
CRUD_JSON_LOGS=false

# ── Debug-only ─────────────────────────────────────────────────────────

# When true, SQLAlchemy echoes every SQL statement to stdout. NEVER
# enable in production — leaks PII into logs.
CRUD_DB_ECHO=false
