# Parity runner + screenshot runner.
FROM mcr.microsoft.com/playwright/python:v1.47.0-jammy

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

RUN pip install --no-cache-dir "httpx==0.27.0" "playwright==1.47.0"
# Chromium binaries pre-installed in the base image; we add the Python bindings here.

CMD ["python", "/app/parity-runner.py"]
